# Dev-deployment (infra) env — the container-password SECRETS compose provisions
# the local stack with (ADR 0026, #127). This file is disjoint from the root
# .env, which owns the application runtime surface (app secrets + STRIPE_API_BASE).
#
# `pnpm with-env` loads BOTH (`dotenv -e ./.env -e ./deploy/.env`), so these
# passwords are single-sourced here yet available to both compose (interpolated
# into deploy/compose.yaml at parse time) and the app (its Postgres/Redis clients).
#
# Same rule as root .env.example:
#   KEY=value -> non-secret, used as-is, never touches the secrets backend.
#   KEY=      -> secret, pulled from / pushed to the backend (SECRET_MAP: infra).
# Copy to deploy/.env and fill: `cp deploy/.env.example deploy/.env`.

# Postgres superuser password for the local `postgres` container. A throwaway
# dev default — not a real secret — so it ships as a literal.
DB_PASSWORD=password123

# Redis AUTH password. Empty in dev (redis runs open locally); a real deploy
# supplies one, so it is classified as a secret.
REDIS_PASSWORD=
