import { createDb } from '@acme/db';
import { createFeatureTRPCWithDb } from '@acme/trpc';

/**
 * The feature's one tRPC instance.
 *
 * `createFeatureTRPCWithDb` supplies the neutral base context every feature
 * shares — the app-injected session (`ctx.session`, whose `user` is non-null
 * inside `protectedProcedure`), the injected entitlements provider, and the
 * billing context resolved from it — plus an OTel-instrumented `ctx.db`.
 *
 * This feature names no identity provider and no billing implementation: the app
 * resolves both at its HTTP boundary and injects them (ADR 0003 / ADR 0006).
 * Telemetry is ambient (ADR 0023) — read the active span with
 * `trace.getActiveSpan()`; there is no `ctx.telemetry`.
 *
 * If this feature owns no database, drop `createDb()` and swap
 * `createFeatureTRPCWithDb(_db)` for `createFeatureTRPC()`.
 */
const _db = createDb();

export const db = _db;
export type db = typeof _db;

export const {
  createTRPCContext,
  createTRPCRouter,
  createCallerFactory,
  publicProcedure,
  protectedProcedure,
  adminProcedure,
  rateLimit,
  requireTier,
} = createFeatureTRPCWithDb(_db);
