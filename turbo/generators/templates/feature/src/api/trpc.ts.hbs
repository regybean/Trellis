import { createDb } from '@acme/db';
import { createFeatureTRPCWithDb } from '@acme/trpc';

/**
 * The feature's tRPC instance. Everything shared — context assembly, telemetry,
 * timing, `protectedProcedure` / `adminProcedure`, `rateLimit`, `requireTier` —
 * lives once in `@acme/trpc`; this file only names the database the feature owns
 * and re-exports the pieces its routers use.
 *
 * The session and the entitlements provider are *injected* by the app at its
 * edge (ADR 0003 / ADR 0006), so nothing here imports an auth SDK or a billing
 * implementation. Procedures read the caller off `ctx.session.user`.
 */
const _db = createDb();

export const db = _db;
export type db = typeof _db;

export const {
  createTRPCContext,
  createTRPCRouter,
  createCallerFactory,
  publicProcedure,
  protectedProcedure,
  adminProcedure,
  rateLimit,
  requireTier,
} = createFeatureTRPCWithDb(_db);
