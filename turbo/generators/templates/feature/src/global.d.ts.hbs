// Global type declarations for the platform's injected principal. No auth
// provider is named here: `@acme/trpc` owns the `InjectedUser` seam, and a
// feature's program can't include the platform's own `global.d.ts`, so the base
// is redeclared. Augment it with any extra field this feature reads off
// `ctx.session.user` — the app injecting it must then supply that field.
export type Roles = 'admin' | 'user';

declare global {
  interface InjectedUser {
    id: string;
    role?: Roles;
  }
}
