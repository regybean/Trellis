/**
 * Test context — {{ kebabCase name }}.
 *
 * The tRPC caller context comes from the one canonical builder
 * (`@acme/trpc/testing`), so it can never drift from what the real
 * `createTRPCContext` assembles. It stubs the session — the only layer we don't
 * want to exercise here — and injects a mock entitlements provider; db/redis are
 * the REAL clients, pointed at testcontainers. Telemetry is ambient (ADR 0023):
 * no span in a caller test, so nothing to stub.
 *
 * This file owns only the feature's data cleanup.
 */
import { flushTestDb } from '@acme/redis/testing';

import { items } from '../../../api/schemas/item-schema';
import { db } from '../../../api/trpc';

export { createTestContext } from '@acme/trpc/testing';
export type { TestContextOptions } from '@acme/trpc/testing';

/**
 * Remove all rows this feature owns + flush the isolated Redis DB. Call in
 * `beforeEach` for isolation between tests.
 */
export async function cleanupTestData() {
  try {
    await db.delete(items);
  } catch {
    // Table might not exist yet — nothing to clean.
  }

  await flushTestDb();
}
