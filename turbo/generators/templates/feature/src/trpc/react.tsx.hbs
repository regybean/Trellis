'use client';

import { createFeatureClient } from '@acme/hooks';

import type { AppRouter } from '../api/root';
import { env } from '../env';

// This feature's client half, assembled from the shared factory (`@acme/hooks`).
// Everything identical across features — the `NODE_ENV==='test'` `httpLink` MSW
// seam (ADR 0018), the provider tree, the optional per-query persister — lives
// once in the factory; only this feature's genuine variation is spelled out
// here: its router type, endpoint (`/api/trpc/{{ kebabCase name }}`), and
// transport.
//
// No `QueryClient`. The app mounts exactly one and this provider reads it from
// context (ADR 0036). To opt into offline read, add a `persister` option here
// and spread `usePersistedQueryOptions()` into the queries that should persist
// (ADR 0025).
const client = createFeatureClient<AppRouter>({
  keyPrefix: '{{ kebabCase name }}',
  nodeEnv: env.NODE_ENV,
  transport: 'batch-stream',
});

// One binding at a time, NOT `export const { … } = client`. These modules are
// `'use client'` boundaries: Next's client-reference manifest is built from
// statically-named export declarations, and a destructuring pattern isn't one —
// the provider silently resolves to `undefined` in an app build ("Element type
// is invalid" when prerendering). Keep the explicit form.
export const TRPCProvider = client.FeatureTRPCProvider;
export const useTRPC = client.useTRPC;
