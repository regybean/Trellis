import { createEnv } from '@t3-oss/env-core';
import { z } from 'zod/v4';

import { readEnv, resolveAppEnv, webappSchema, withProfiles } from '@acme/env';

/** The deploy-target selector, resolved at this slice's `process.env` edge. */
const appEnv = resolveAppEnv(process.env.APP_ENV);

/**
 * {{ pascalCase name }}'s environment, declared once (ADR 0033) — the slice's whole
 * surface in one `createEnv` call, composed into an app's env graph via
 * `extends: [{{ camelCase name }}Env(), …]`.
 *
 * Two rules to keep this conformant as you add keys:
 *
 * 1. **Config vs secret is mechanical.** A key the profile below supplies a
 *    value for is config; a key it doesn't is a secret the deploy target must
 *    provide. Never pass `skipValidation` — `withProfiles` relaxes secrets, and
 *    only secrets, on a run that cannot supply one (ADR 0033 §3).
 * 2. **Every key goes in `runtimeEnv`**, so every key is env-overridable
 *    (ADR 0033 §4). Use `readEnv('KEY')` for all of them *except* the keys a
 *    bundler inlines textually — `NODE_ENV` and `NEXT_PUBLIC_*` must stay
 *    written longhand as `process.env.NODE_ENV`, because an index access is
 *    invisible to static inlining and the value would vanish from the client
 *    bundle.
 *
 * Non-secret values that differ per deploy target belong in the profiles, not in
 * a `.env` file. Once a profile grows past a few keys, extract it to a
 * `development-profile.ts` beside this file (see `@acme/redis`, `@acme/rag`).
 */
export function {{ camelCase name }}Env() {
  return createEnv({
    clientPrefix: 'NEXT_PUBLIC_',
    client: {},
    shared: {
      NODE_ENV: z.enum(['development', 'production', 'test']),
      // Per-app identity — Postgres/pgvector schema + Redis prefix.
      NEXT_PUBLIC_WEBAPP: webappSchema,
    },
    server: {
      // Connection details for the shared local stack: profile values, so a
      // clean checkout with no `.env` row works, and still overridable (a
      // testcontainer hands back a mapped port; prod endpoints are injected).
      REDIS_URL: z.url(),
      DB_HOST: z.string().nonempty(),
      DB_PORT: z.coerce.number().int().positive(),
      DB_USER: z.string().nonempty(),
      DB_NAME: z.string().nonempty(),
      // No profile value -> a secret. Required on every deploy target, and
      // relaxed only on runs that cannot supply one.
      DB_PASSWORD: z.string().nonempty(),
    },
    createFinalSchema: (shape) =>
      withProfiles(shape, appEnv, {
        default: {
          NODE_ENV: 'development',
          // The local compose stack (see `deploy/compose.yaml`). Postgres is on
          // 5444, not 5432, so the default can't collide with another project's
          // Postgres on this machine.
          REDIS_URL: 'redis://localhost:6379',
          DB_HOST: 'localhost',
          DB_PORT: 5444,
          DB_USER: 'postgres',
          DB_NAME: 'testdb',
        },
      }),
    runtimeEnv: {
      // Inlined textually by the bundler — must stay longhand.
      NODE_ENV: process.env.NODE_ENV,
      NEXT_PUBLIC_WEBAPP: process.env.NEXT_PUBLIC_WEBAPP,
      REDIS_URL: readEnv('REDIS_URL'),
      DB_HOST: readEnv('DB_HOST'),
      DB_PORT: readEnv('DB_PORT'),
      DB_USER: readEnv('DB_USER'),
      DB_NAME: readEnv('DB_NAME'),
      DB_PASSWORD: readEnv('DB_PASSWORD'),
    },
    emptyStringAsUndefined: true,
  });
}

export const env = {{ camelCase name }}Env();
