{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead-code / unused-dependency gate. Scoped to the classes that indicate a
  // real defect in a monorepo of libraries: files nothing reaches, dependencies
  // nothing imports, and imports nothing declares.
  //
  // `exports` and `types` are deliberately absent. Every package here is a
  // library consumed across a workspace boundary through its `exports` map, and
  // the apps are reference compositions rather than the full set of intended
  // consumers — so a slice export with no in-repo caller is the normal state of
  // its public API, not dead code. Reporting it trains the reader to ignore the
  // gate.
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "unresolved",
    "binaries",
    "catalog",
  ],

  // Installed on the runner by the gitleaks action / brew, never a package dep.
  "ignoreBinaries": ["gitleaks"],

  // Named as a postcss *plugin string* in @acme/tailwind-config/postcss-config,
  // which each app re-exports from its own postcss.config.js — postcss resolves
  // it from the app's node_modules, so the app must declare it with no import.
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "postcss",
    // Invoked as a binary from the shell (`pnpm exec tsx scripts/…` in
    // scripts/*.sh), which knip does not parse.
    "tsx",
  ],

  "workspaces": {
    ".": {
      // Shell-invoked (`pnpm exec tsx scripts/…` from scripts/dev.sh) and
      // turbo-invoked (`pnpm turbo gen`) — reachable, but not from any import.
      "entry": [
        "scripts/*.ts",
        "turbo/generators/config.ts",
        "turbo/generators/templates/**",
      ],
      "project": ["scripts/*.ts", "turbo/**/*.ts"],
    },
    "apps/*": {
      // Two roots of the graph, per app. `drizzle.push.config.ts` is read by
      // the drizzle-kit CLI via `--config`, and the drizzle plugin only knows
      // about the default `drizzle.config.ts`. `src/env.ts` is the app's one
      // env composition edge — nothing imports it, so declaring it an entry is
      // what keeps its own imports counted. Stated for every app because it is
      // the convention rather than one app's quirk.
      //
      // Known defect this therefore hides, recorded here because nothing else
      // records it: one slim app never *loads* its `src/env.ts` at boot, so its
      // env is validated by nothing at startup. Declaring the entry was always
      // orthogonal to that — knip asks what imports a file, not what runs it —
      // and the fix is an import in the app's server entry, not a knip key.
      "entry": ["drizzle.push.config.ts", "src/env.ts"],
    },
    "packages/features/ingest": {
      // `src/tests/backend/setup.ts` does `vi.mock('@acme/models', …)`. The mock
      // is a string, so knip sees no import — but vitest still has to *resolve*
      // the specifier, which needs the workspace symlink this devDependency
      // creates. Removing it breaks the suite in CI only. See the note in that
      // file.
      "ignoreDependencies": ["@acme/models"],
      "entry": ["src/trpc/server.tsx"],
    },
    "packages/features/chat": {
      // The Mastra CLI entry (`mastra dev|lint --dir src/mastra`).
      "entry": ["src/mastra/index.ts", "src/trpc/server.tsx"],
    },
    "packages/features/*": {
      // Documented reference scaffold for an RSC caller; no app mounts one yet,
      // but it is part of the slice's intended surface, so it is a graph root
      // rather than dead code.
      "entry": ["src/trpc/server.tsx"],
    },
  },
}
