# Shared infrastructure. Source of truth for env:pull / env:push.
#
# Rule:  KEY=value  -> non-secret, used as-is, never touches the secrets backend.
#        KEY=       -> secret, pulled from / pushed to the backend.
# The values below are local-dev defaults (non-secret).
#
# Secrets sync is OPT-IN. By default just `cp .env.example .env` and fill the
# empty (secret) values by hand. To use the pluggable sync instead, pick a
# backend with ONE env var (not stored here — it lives in your shell):
#   SECRETS_BACKEND=localstack pnpm env:pull   # dev/demo: the infra LocalStack vault
#   SECRETS_BACKEND=aws        pnpm env:pull   # a real cloud vault (AWS Secrets Manager)
# `localstack` needs nothing else (dummy creds baked in); seed it once per fresh
# `pnpm infra:up` with `SECRETS_BACKEND=localstack pnpm env:push`. See ADR 0001.
# NB: the AWS_* keys further down are for the Bedrock model provider, NOT sync.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=testdb
DB_VECTOR_NAME=vectordb
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- localstripe (dependency-free dev billing, default) ------------------
# Billing runs against the local `localstripe` infra service by default — no
# Stripe account or network needed. `pnpm infra:up` seeds the products/plans
# + webhook; grant tiers from the admin page (Set Tier). All dummy non-secret
# values. See docs/adr/0004-localstripe-dev-billing.md.
# To use real Stripe instead: unset STRIPE_API_BASE and pull the real keys
# (`pnpm env:pull`).
STRIPE_API_BASE=http://localhost:8420
STRIPE_SECRET_KEY=sk_test_localstripe
STRIPE_WEBHOOK_SECRET=whsec_localstripe
STRIPE_SUCCESS_URL=http://localhost:3000/billing
STRIPE_CANCEL_URL=http://localhost:3000/billing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_localstripe
NEXT_PUBLIC_STRIPE_MANAGE_BILLING_URL=http://localhost:3000/billing
NEXT_PUBLIC_STRIPE_STANDARD_PLAN_ID=prod_dev_standard
NEXT_PUBLIC_STRIPE_PRO_PLAN_ID=prod_dev_pro

# Provider selection, model ids, region, embedding dimension and the S3
# endpoint/bucket are config-as-code now (@acme/models/config, @acme/ingest/config,
# ADR 0026) — no longer env. Only the provider *secrets* and the values
# `infra:up` provisions remain below.

# Ollama models the local `infra:up` ollama service PULLS (chat + embeddings).
# The app reads these as config (@acme/models/config base profile); keep the two
# in sync. Reached over its OpenAI-compatible /v1 endpoint.
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Model-provider secrets — Bedrock (via the AWS chain) + OpenRouter API key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENROUTER_API_KEY=
