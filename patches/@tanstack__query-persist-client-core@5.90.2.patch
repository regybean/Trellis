diff --git a/build/modern/createPersister.js b/build/modern/createPersister.js
index b8dd818..1fb628c 100644
--- a/build/modern/createPersister.js
+++ b/build/modern/createPersister.js
@@ -97,7 +97,11 @@ function experimental_createQueryPersister({
             errorUpdatedAt: persistedQuery.state.errorUpdatedAt
           });
           if (query.isStale()) {
-            query.fetch();
+            // trellis patch (@acme/hooks ADR 0001): swallow background-revalidation failure.
+            // The restored snapshot is already shown; with staleTime:0 this fetch
+            // fires on every mount, and a failed one (e.g. offline) would be an
+            // unhandled rejection since Query.fetch() re-throws. Data survives.
+            query.fetch().catch(() => {});
           }
         }
       );
