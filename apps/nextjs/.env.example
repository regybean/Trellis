# Next.js app env. Source of truth for env:pull / env:push.
#
# Rule:  KEY=value  -> non-secret, used as-is, never touches the secrets backend.
#        KEY=       -> secret, pulled from / pushed to the backend.
#        NEXT_PUBLIC_* are ALWAYS non-secret (they ship in the client bundle)
#                      and are never pushed, even when left empty here.

NEXT_PUBLIC_WEBAPP=nextjs
PORT=3000

# ── Clerk (auth) ──────────────────────────────────────────────────────────
# Sign-in/up route URLs and the publishable key are now config-as-code
# (@acme/auth/config, ADR 0026). Only Clerk secrets remain here.
CLERK_SECRET_KEY=

# ── Better Auth (self-hosted auth, #218) ──────────────────────────────────
# Signs session cookies and encrypts stored tokens. Required by @acme/auth/env,
# which both full apps compose. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Stripe (billing) ──────────────────────────────────────────────────────
# Every non-secret Stripe value is config-as-code now (@acme/billing/config, ADR
# 0026): plan IDs / publishable key / manage-billing URL (client) and the
# checkout redirect paths (server). The redirect origin is the app's own (PORT),
# threaded in at the app edge. Only the secrets remain here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Model providers (secrets) ─────────────────────────────────────────────
# Bedrock (via the AWS credential chain) + OpenRouter. Provider selection, model
# ids, region and embedding dimension are config-as-code (@acme/models/config,
# ADR 0026); only the provider secrets live here. Each app owns these directly —
# the shared root .env was deprecated (ADR 0029), so they are duplicated per app.
# Empty is fine locally: the default Ollama provider needs no credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENROUTER_API_KEY=
