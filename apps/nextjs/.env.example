# Next.js app env. Source of truth for env:pull / env:push.
#
# Rule:  KEY=value  -> non-secret, used as-is, never touches the secrets backend.
#        KEY=       -> secret, pulled from / pushed to the backend.
#        NEXT_PUBLIC_* are ALWAYS non-secret (they ship in the client bundle)
#                      and are never pushed, even when left empty here.
#
# An empty row here means "unset": the slice's development profile supplies the
# local value (localstripe's placeholders, LocalStack's dummy AWS pair), and a
# real deploy target must supply the real secret.

NEXT_PUBLIC_WEBAPP=nextjs
PORT=3000

# ── Better Auth (self-hosted auth, #223) ──────────────────────────────────
# Signs session cookies and encrypts stored tokens. Required by
# @acme/auth/env's betterAuthEnv(), which this app composes.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin the auth routes are served from — this app's own. Not authored
# config: it is per-app (PORT) and per-deploy, so no profile could hold it. On a
# deploy target this must be the externally reachable URL, not the container's.
BETTER_AUTH_URL=http://localhost:3000

# ── Stripe (billing) ──────────────────────────────────────────────────────
# Every non-secret Stripe value is authored config (@acme/billing/env, ADR 0033):
# plan ids / publishable key / manage-billing URL (browser-safe) and the checkout
# redirect paths + connection (server). The redirect origin is the app's own
# (PORT), threaded in at the app edge. Only the secrets remain here — and every
# authored key can be set here to override it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Model providers (secrets) ─────────────────────────────────────────────
# Bedrock (via the AWS credential chain) + OpenRouter. Provider selection, model
# ids, region and embedding dimension are authored config (@acme/models/env,
# ADR 0033); only the provider secrets live here. Each app owns these directly —
# the shared root .env was deprecated (ADR 0029), so they are duplicated per app.
# Empty is fine locally: the default Ollama provider needs no credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENROUTER_API_KEY=
