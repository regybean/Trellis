# TanStack Start app env. Source of truth for env:pull / env:push.
#
# Rule:  KEY=value  -> non-secret, used as-is, never touches the secrets backend.
#        KEY=       -> secret, pulled from / pushed to the backend.
#        NEXT_PUBLIC_* are ALWAYS non-secret (they ship in the client bundle)
#                      and are never pushed, even when left empty here.

# Own per-app Postgres schema — isolated from every other app (ADR-0002).
NEXT_PUBLIC_WEBAPP=tanstack_slim
PORT=3003

# ── Clerk (auth) ──────────────────────────────────────────────────────────
# Sign-in/up route URLs and the publishable key are now config-as-code
# (@acme/auth/config, ADR 0026), threaded into <ClerkProvider> + clerkMiddleware.
# The bare CLERK_PUBLISHABLE_KEY is kept as a safety net for the
# @clerk/tanstack-react-start server SDK pending a staging smoke test (#94).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Stripe (billing) ──────────────────────────────────────────────────────
# Plan IDs, publishable key and manage-billing URL are config-as-code
# (@acme/billing/config, ADR 0026). Secrets + server checkout URLs remain here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3001/billing?success=true
STRIPE_CANCEL_URL=http://localhost:3001/billing?canceled=true
